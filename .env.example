# Runtime
NODE_ENV=development
PORT=3000
NUXT_TELEMETRY_DISABLED=1

# Site and SEO
NUXT_SITE_URL=http://localhost:3000
NUXT_SITE_NAME=Sin
NUXT_SITE_DESCRIPTION=Интернет-магазин SIN
NUXT_DEFAULT_LOCALE=ru

# Content (Strapi)
STRAPI_URL=https://strapi.example.com
STRAPI_TOKEN=replace-with-read-only-token

# Commerce (Medusa)
NUXT_MEDUSA_URL=https://medusa.example.com
NUXT_MEDUSA_TOKEN=replace-with-publishable-api-key
# Medusa authentication provider ID for Yandex ID.
NUXT_YANDEX_AUTH_PROVIDER=yandex
# Click and collect. `pp_system` is Medusa's manual payment provider.
NUXT_PUBLIC_PICKUP_SHIPPING_OPTION_ID=replace-with-pickup-shipping-option-id
# Optional. By default the storefront finds the enabled `pp_system*` provider.
# NUXT_PUBLIC_PICKUP_PAYMENT_PROVIDER_ID=pp_system_default

# Search (Meilisearch)
NUXT_SEARCH_URL=https://search.example.com
NUXT_SEARCH_API_KEY=replace-with-search-only-api-key

# Media and maps
NUXT_PUBLIC_CDN_DOMAIN=cdn.example.com
NUXT_PUBLIC_MEDIA_STORAGE_URL=https://storage.example.com
NUXT_YANDEX_API_KEY=replace-with-yandex-maps-key

# Store locations XML (server-only)
FTP_HOST=ftp.example.com
FTP_USER=replace-with-ftp-user
FTP_PASS=replace-with-ftp-password
