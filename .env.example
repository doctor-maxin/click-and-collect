# Пример переменных окружения для Nuxt.js приложения
# Скопируйте этот файл в .env и заполните актуальными значениями

# =============================================================================
# ОСНОВНЫЕ НАСТРОЙКИ ПРИЛОЖЕНИЯ
# =============================================================================

# Окружение (development, staging, production)
NODE_ENV=production

# Порт для запуска приложения
PORT=3000

# Базовый URL приложения
NUXT_PUBLIC_BASE_URL=https://your-domain.com

# =============================================================================
# API НАСТРОЙКИ
# =============================================================================

# Базовый URL для API запросов
NUXT_PUBLIC_API_BASE=https://api.your-domain.com

# URL Strapi CMS
STRAPI_URL=https://strapi.your-domain.com

# API ключи
API_KEY=your-api-key-here
STRAPI_API_TOKEN=your-strapi-api-token

# =============================================================================
# БАЗА ДАННЫХ
# =============================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Redis connection string
REDIS_URL=redis://localhost:6379

# =============================================================================
# АУТЕНТИФИКАЦИЯ И БЕЗОПАСНОСТЬ
# =============================================================================

# JWT секретный ключ
JWT_SECRET=your-super-secret-jwt-key-here

# Ключи для шифрования
ENCRYPTION_KEY=your-encryption-key-here
APP_SECRET=your-app-secret-here

# =============================================================================
# ВНЕШНИЕ СЕРВИСЫ
# =============================================================================

# Email сервис
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASS=your-email-password

# AWS S3 (если используется)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Cloudinary (если используется)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =============================================================================
# ПЛАТЕЖНЫЕ СИСТЕМЫ
# =============================================================================

# Stripe
STRIPE_PUBLIC_KEY=pk_test_your_public_key
STRIPE_SECRET_KEY=sk_test_your_secret_key

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# =============================================================================
# АНАЛИТИКА И МОНИТОРИНГ
# =============================================================================

# Google Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX-X

# Sentry для отслеживания ошибок
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# FTP/SFTP (если используется для файлов)
# =============================================================================

FTP_HOST=your-ftp-host.com
FTP_USER=your-ftp-username
FTP_PASS=your-ftp-password
FTP_PORT=21

# =============================================================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# =============================================================================

# Отключить телеметрию Nuxt
NUXT_TELEMETRY_DISABLED=1

# Таймзона
TZ=Europe/Moscow

# Максимальный размер загружаемых файлов (в байтах)
MAX_FILE_SIZE=10485760

# Включить дебаг режим (true/false)
DEBUG=false

# =============================================================================
# КЭШИРОВАНИЕ
# =============================================================================

# Время жизни кэша в секундах
CACHE_TTL=3600

# Префикс для ключей кэша
CACHE_PREFIX=storefront:
